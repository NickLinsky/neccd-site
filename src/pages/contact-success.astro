---
import Base from '../layouts/Base.astro';
---

<Base title="Message sent" description="Your message has been received.">

  <section class="section">
    <div class="container success-wrap">
      <div class="success-icon">✅</div>
      <h1 class="section-heading">Message sent!</h1>
      <p>Thanks for reaching out. We'll get back to you as soon as we can.</p>
      <div class="success-actions">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/events" class="btn btn-ghost">See upcoming events</a>
      </div>
    </div>
  </section>

</Base>

<style>
.success-wrap { max-width: 480px; text-align: center; padding: 4rem 0; }
.success-icon { font-size: 3rem; margin-bottom: 1rem; }
.success-wrap p { color: var(--muted); margin-bottom: 2rem; font-size: 1rem; line-height: 1.6; }
.success-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
</style>
